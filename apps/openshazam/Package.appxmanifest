<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">
  <Identity
    Name="OpenShazam.Windows"
    Publisher="CN=OpenShazam Development"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>OpenShazam</DisplayName>
    <PublisherDisplayName>OpenShazam Development</PublisherDisplayName>
    <Logo>assets\OpenShazamStoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
    <PackageDependency
      Name="Microsoft.WindowsAppRuntime.1.8"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US"
      MinVersion="8000.806.2252.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application
      Id="OpenShazam"
      Executable="openshazam.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="OpenShazam"
        Description="OpenShazam Windows UI"
        BackgroundColor="transparent"
        Square44x44Logo="assets\OpenShazamSquare44.png"
        Square150x150Logo="assets\OpenShazamSquare150.png" />
      <Extensions>
        <uap5:Extension
          Category="windows.startupTask"
          Executable="openshazam.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask
            TaskId="OpenShazamStartup"
            Enabled="false"
            DisplayName="OpenShazam" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
